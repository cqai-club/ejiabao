NODE_ENV=development
HOST=0.0.0.0
PORT=8787
DATABASE_URL=postgresql://ejiabao:ejiabao@localhost:5432/ejiabao?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-at-least-32-characters

# 云端 API 的固定 HTTPS 地址；U 盘桌面端不需要域名，但必须能访问这个地址。
API_PUBLIC_URL=https://YOUR_CLOUD_SERVER_IP:8787
# file:// 桌面端的 Origin 通常表现为 null；部署管理后台时可追加来源并用逗号分隔。
WEB_ORIGIN=null,file://

# Alibaba Cloud OSS（生产环境建议使用 RAM 子账号，限制到指定 Bucket/前缀）。
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=ejiabao
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
# 本地开发可开启，上传会落到 backend/runtime/uploads，不依赖 OSS CORS。
LOCAL_STORAGE_ENABLED=false
LOCAL_STORAGE_DIR=./runtime/uploads

# OpenAI API 只允许在云端后端使用，绝不写入桌面端或 U 盘静态文件。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# DeepSeek 官方 API（通过 OpenAI-compatible /chat/completions；仅云端后端调用）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Codex 中转：必须兼容 OpenAI Responses API（POST /v1/responses + Bearer）。
CODEX_API_KEY=
CODEX_BASE_URL=https://zrocode.cc/v1
CODEX_MODEL=gpt-5.3-codex
CODEX_REASONING_EFFORT=medium

# 用于加密平台 OAuth token 的 32-byte AES-256-GCM key（64 位十六进制）。
PLATFORM_TOKEN_ENCRYPTION_KEY=

# Ed25519 授权密钥；NetShield/Windows 原生设备挑战协议确定后再生成并接入。
DEVICE_LICENSE_PRIVATE_KEY_B64=
DEVICE_LICENSE_PUBLIC_KEY_B64=

# Codex / DeepSeek Harness 服务端代理。真实 endpoint、鉴权和请求响应格式待你提供后接入。
CODEX_PROXY_URL=
CODEX_PROXY_TOKEN=
DEEPSEEK_HARNESS_PROXY_URL=
DEEPSEEK_HARNESS_PROXY_TOKEN=

# InferFlow 数字人工作流（仅后端使用；暂不启动真实任务）。
INFERFLOW_ENABLED=false
INFERFLOW_API_KEY=
INFERFLOW_BASE_URL=https://saas.inferflow.dev/openapi/v1

# 首发版本只使用邮箱或手机号 + 密码，不启用短信/邮箱验证码；社交平台授权延后到 OTA。
DISABLE_SOCIAL_OAUTH=true
# 仅用于本机开发预览管理界面；生产环境必须保持 false。
ADMIN_PREVIEW_MODE=false
ADMIN_DIRECT_ACCESS=false

# 以下配置为后续 OTA 预留，当前不会启用。
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=
XHS_APP_ID=
XHS_APP_SECRET=
XHS_REDIRECT_URI=
XHS_AUTHORIZE_URL=
XHS_TOKEN_URL=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
BILIBILI_CLIENT_ID=
BILIBILI_CLIENT_SECRET=
BILIBILI_REDIRECT_URI=
BILIBILI_AUTHORIZE_URL=
BILIBILI_TOKEN_URL=

# 微信支付 Native 扫码支付（仅部署在云服务器）。商户号本身不足以完成 API v3 调用。
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_B64=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_B64=
WECHAT_PAY_NOTIFY_URL=https://YOUR_CLOUD_SERVER_IP:8787/v1/billing/wechat/notify
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
# 金额单位为分，credits 为到账额度；正式上线前替换为你们确认的套餐价格。
QUOTA_PACKAGES_JSON=[]
# 生产环境保持 false。六大工作流定价落地后改由服务端报价，不能由客户端传 credits。
ALLOW_CLIENT_TASK_CREDITS=false

# 商品推广工作流（dsh-product-promo）。Python 与 FFmpeg 仅部署在云端工作机，绝不放入 U 盘客户端。
# Windows 示例：PRODUCT_PROMO_PYTHON_BIN=C:\\Python312\\python.exe
PRODUCT_PROMO_ENABLED=true
PRODUCT_PROMO_PYTHON_BIN=python
# 留空时默认使用 backend/workflows/dsh-product-promo。
PRODUCT_PROMO_WORKFLOW_DIR=
# 留空时默认使用 backend/runtime/workflows；生产环境建议改为独立的大容量数据盘目录。
WORKFLOW_DATA_DIR=
PRODUCT_PROMO_TIMEOUT_SECONDS=3600
# 45 秒成片默认消耗 6 积分（每 15 秒 2 积分）；报价始终由服务端计算。
PRODUCT_PROMO_CREDITS_PER_15_SECONDS=2
VLOG_EDIT_ENABLED=true
VLOG_EDIT_PYTHON_BIN=python
# 留空时默认使用 backend/workflows/dsh-vlog-edit。
VLOG_EDIT_WORKFLOW_DIR=
VLOG_EDIT_TIMEOUT_SECONDS=3600
VLOG_EDIT_CREDITS_PER_15_SECONDS=2
DRAMA_SHORT_ENABLED=true
DRAMA_SHORT_PYTHON_BIN=python
# 留空时默认使用 backend/workflows/dsh-drama-short。
DRAMA_SHORT_WORKFLOW_DIR=
DRAMA_SHORT_TIMEOUT_SECONDS=3600
DRAMA_SHORT_CREDITS_PER_15_SECONDS=3
# dsh-podcast：话题/双人对话稿 → 双人配音 → 波形视频与发布包
PODCAST_ENABLED=true
PODCAST_PYTHON_BIN=python
# 留空时默认使用 backend/workflows/dsh-podcast
PODCAST_WORKFLOW_DIR=
PODCAST_TIMEOUT_SECONDS=3600
PODCAST_CREDITS_PER_15_SECONDS=3
# dsh-event-promo：活动信息 + 海报/二维码 → 倒计时、亮点、报名引导视频
EVENT_PROMO_ENABLED=true
EVENT_PROMO_PYTHON_BIN=python
# 留空时默认使用 backend/workflows/dsh-event-promo
EVENT_PROMO_WORKFLOW_DIR=
EVENT_PROMO_TIMEOUT_SECONDS=3600
EVENT_PROMO_CREDITS_PER_15_SECONDS=2
# 若 ffmpeg 未加入 PATH，可填写其绝对路径；TTS 目录按需配置，未配置时工作流会降级为无声草稿。
DSH_FFMPEG=
DSH_DIGITAL_HUMAN=
DSH_TTS_PYTHON=
DSH_TTS_SCRIPT=

# 仅用于 docker-compose.cloud.yml 的 PostgreSQL 容器。
POSTGRES_USER=ejiabao
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=ejiabao
API_PORT=8787
