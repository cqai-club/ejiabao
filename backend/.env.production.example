# ===== e剪宝 生产环境变量模板 =====
# 使用方法： cp backend/.env.production.example backend/.env 后逐项填写。
# 所有密钥务必通过安全渠道生成并保管，切勿提交到 Git。

# ---- 运行环境 ----
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
# 前端产物目录；Docker 部署时使用镜像内固定路径（见根 Dockerfile）。
FRONTEND_DIR=/app/frontend

# ---- 数据库（生产请用托管或独立 PostgreSQL，勿用默认口令） ----
# 例：postgresql://user:pass@host:5432/db?schema=public
DATABASE_URL=

# ---- 认证密钥（必填，至少 32 字符随机串） ----
# 生成： node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---- 对外地址 / 跨域 ----
# 云端 API 的固定 HTTPS 地址，U 盘桌面端通过它访问后端。
API_PUBLIC_URL=https://api.yourdomain.com
# file:// 桌面端 Origin 为 null；如需 Web 后台访问，追加 https://yourdomain.com，逗号分隔。
WEB_ORIGIN=null,file://

# ---- 阿里云 OSS（生产必填；建议最小权限 RAM 子账号） ----
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=ejiabao
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 公开读 Bucket 的访问域名，例如 https://ejiabao.oss-cn-hangzhou.aliyuncs.com
OSS_PUBLIC_BASE_URL=
# 生产必须为 false，否则上传落到本地磁盘。
LOCAL_STORAGE_ENABLED=false
LOCAL_STORAGE_DIR=./runtime/uploads

# ---- AI 通道（按需填写；密钥只留在云端后端） ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Codex 中转（必须兼容 OpenAI Responses API）
CODEX_API_KEY=
CODEX_BASE_URL=https://zrocode.cc/v1
CODEX_MODEL=gpt-5.3-codex
CODEX_REASONING_EFFORT=medium

CODEX_PROXY_URL=
CODEX_PROXY_TOKEN=
DEEPSEEK_HARNESS_PROXY_URL=
DEEPSEEK_HARNESS_PROXY_TOKEN=

# ---- 平台密钥加密 / 设备授权（按需） ----
# 32-byte AES-256-GCM key 的 64 位十六进制；生成同 JWT 方法。
PLATFORM_TOKEN_ENCRYPTION_KEY=
# Ed25519 私钥/公钥（Base64）；协议确定前留空。
DEVICE_LICENSE_PRIVATE_KEY_B64=
DEVICE_LICENSE_PUBLIC_KEY_B64=

# ---- InferFlow 数字人（按需） ----
INFERFLOW_ENABLED=false
INFERFLOW_API_KEY=
INFERFLOW_BASE_URL=https://saas.inferflow.dev/openapi/v1

# ---- 安全开关 ----
DISABLE_SOCIAL_OAUTH=true
# 生产必须保持 false！
ADMIN_PREVIEW_MODE=false
ADMIN_DIRECT_ACCESS=false

# ---- 社交平台 OAuth（OTA 预留，暂不启用） ----
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=
XHS_APP_ID=
XHS_APP_SECRET=
XHS_REDIRECT_URI=
XHS_AUTHORIZE_URL=
XHS_TOKEN_URL=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
BILIBILI_CLIENT_ID=
BILIBILI_CLIENT_SECRET=
BILIBILI_REDIRECT_URI=
BILIBILI_AUTHORIZE_URL=
BILIBILI_TOKEN_URL=

# ---- 微信支付 Native 扫码（上线收款必填，材料见 WECHAT-PAY-INTEGRATION.md） ----
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_B64=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_B64=
WECHAT_PAY_NOTIFY_URL=https://api.yourdomain.com/v1/billing/wechat/notify
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
# 金额单位分；credits 为到账额度。如 [{"key":"starter","name":"100积分","credits":100,"amountFen":990}]
QUOTA_PACKAGES_JSON=[]
# 生产保持 false，由服务端报价。
ALLOW_CLIENT_TASK_CREDITS=false

# ---- 六大视频工作流（云端容器内已装 python3/ffmpeg） ----
PRODUCT_PROMO_ENABLED=true
PRODUCT_PROMO_PYTHON_BIN=python3
PRODUCT_PROMO_WORKFLOW_DIR=
WORKFLOW_DATA_DIR=/data/workflows
PRODUCT_PROMO_TIMEOUT_SECONDS=3600
PRODUCT_PROMO_CREDITS_PER_15_SECONDS=2
VLOG_EDIT_ENABLED=true
VLOG_EDIT_PYTHON_BIN=python3
VLOG_EDIT_WORKFLOW_DIR=
VLOG_EDIT_TIMEOUT_SECONDS=3600
VLOG_EDIT_CREDITS_PER_15_SECONDS=2
DRAMA_SHORT_ENABLED=true
DRAMA_SHORT_PYTHON_BIN=python3
DRAMA_SHORT_WORKFLOW_DIR=
DRAMA_SHORT_TIMEOUT_SECONDS=3600
DRAMA_SHORT_CREDITS_PER_15_SECONDS=3
PODCAST_ENABLED=true
PODCAST_PYTHON_BIN=python3
PODCAST_WORKFLOW_DIR=
PODCAST_TIMEOUT_SECONDS=3600
PODCAST_CREDITS_PER_15_SECONDS=3
EVENT_PROMO_ENABLED=true
EVENT_PROMO_PYTHON_BIN=python3
EVENT_PROMO_WORKFLOW_DIR=
EVENT_PROMO_TIMEOUT_SECONDS=3600
EVENT_PROMO_CREDITS_PER_15_SECONDS=2
DSH_FFMPEG=
DSH_DIGITAL_HUMAN=
DSH_TTS_PYTHON=
DSH_TTS_SCRIPT=

# ---- docker-compose.prod.yml 使用的 PostgreSQL 容器变量 ----
POSTGRES_USER=ejiabao
POSTGRES_PASSWORD=
POSTGRES_DB=ejiabao
API_PORT=8787