{
  "name": "ejiabao-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:background": "npm run build && node --env-file=.env dist/scripts/start-background.js",
    "stop:background": "node --env-file=.env dist/scripts/stop-background.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "admin:bootstrap": "tsx src/scripts/bootstrap-admin.ts",
    "admin:bootstrap:production": "node dist/scripts/bootstrap-admin.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/modules/provider-config/provider-config-service.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^9.1.0",
    "@prisma/client": "^6.15.0",
    "argon2": "^0.41.1",
    "fastify": "^5.5.0",
    "openai": "^5.12.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prisma": "^6.15.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
