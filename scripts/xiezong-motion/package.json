{
  "name": "xiezong-natural-motion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "still": "remotion still src/index.tsx NaturalTalk",
