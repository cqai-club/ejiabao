    "studio": "remotion studio src/index.tsx"
  },
  "dependencies": {
    "@remotion/cli": "4.0.513",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.513"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.5.4"
  }
}
